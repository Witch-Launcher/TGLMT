#version 460 core
// Compute: shared memory, barrier, atomics, SSBO std430.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Src { float inData[]; };
layout(std430, binding = 1) buffer Dst { float outData[]; };
layout(std430, binding = 2) buffer Ctr { uint counter[]; };
shared float tile[64];
void main() {
    uint i = gl_GlobalInvocationID.x;
    tile[gl_LocalInvocationID.x] = inData[i] * 2.0;
    barrier();
    outData[i] = tile[gl_LocalInvocationID.x] + 1.0;
    if (i == 0u) atomicAdd(counter[0], 1u);
}

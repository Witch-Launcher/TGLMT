<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>AquariumBench</string>
    <!-- CFBundleIdentifier cố ý KHÔNG khai ở đây: nguồn duy nhất là biến
         BUNDLE_ID của Makefile (→ PRODUCT_BUNDLE_IDENTIFIER cho Xcode, và
         script đóng gói ghi thẳng vào plist cho build tay). Khai ở cả hai nơi
         sẽ lệch nhau và Xcode cảnh báo "must be the same as the
         PRODUCT_BUNDLE_IDENTIFIER build setting value". -->
    <key>CFBundleName</key><string>AquariumBench</string>
    <key>CFBundleDisplayName</key><string>AquariumBench</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array><string>AppIcon60x60</string></array>
            <key>UIPrerenderedIcon</key><false/>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array><string>AppIcon60x60</string><string>AppIcon76x76</string></array>
            <key>UIPrerenderedIcon</key><false/>
        </dict>
    </dict>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleVersion</key><string>1.4</string>
    <key>CFBundleShortVersionString</key><string>1.4</string>
    <key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>
    <key>CFBundleDisplayName</key><string>AquariumBench</string>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
                <string>AppIcon76x76</string>
                <string>Icon</string>
            </array>
            <key>UIPrerenderedIcon</key><false/>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
                <string>AppIcon76x76</string>
                <string>Icon</string>
            </array>
            <key>UIPrerenderedIcon</key><false/>
        </dict>
    </dict>
    <key>UILaunchScreen</key><dict/>
    <key>UIStatusBarHidden</key><true/>
    <key>UIViewControllerBasedStatusBarAppearance</key><false/>
    <key>DTPlatformName</key><string>iphoneos</string>
    <key>DTSDKName</key><string>iphoneos26.2</string>
    <key>DTPlatformVersion</key><string>26.2</string>
    <key>MinimumOSVersion</key><string>16.0</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UIFileSharingEnabled</key><true/>
    <!-- UIDeviceFamily cố ý KHÔNG khai ở đây: Xcode ghi đè từ build setting
         TARGETED_DEVICE_FAMILY (1,2) và sẽ cảnh báo nếu plist tự khai.
         Script đóng gói chèn lại key này khi build tay (ngoài Xcode). -->
    <key>UIRequiredDeviceCapabilities</key><array><string>metal</string></array>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string></array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array><string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string></array>
    <!-- Xcode validationUtility: "All interface orientations must be supported
         unless the app requires full screen" — benchmark chiếm trọn màn hình. -->
    <key>UIRequiresFullScreen</key><true/>
</dict>
</plist>
